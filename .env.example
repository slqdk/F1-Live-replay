# Kopiér til .env og udfyld:  cp .env.example .env && nano .env
# .env indeholder din F1-adgangskode — den committes ALDRIG (står i .gitignore).

# ---------- F1 TV (auto-login) ----------
# Containeren logger selv ind og fornyer tokenet (~hver 4. dag).
# Kræver F1 TV Access eller højere. Adgangskoden sendes kun til id.formula1.com.
F1_USERNAME=
F1_PASSWORD=
# Alternativ/nødløsning: login-session-cookien eller rå JWT. Kan også
# indsættes på adminsiden (/admin) uden genstart.
F1_TOKEN=

# ---------- Adgang ----------
# Netværk der må bruge adminsiden. LAN + WireGuard-pool:
ADMIN_ALLOW=30.11.0.0/20,10.0.0.0/20,127.0.0.0/8
# IP på Nginx Proxy Manager, så den rigtige klient-IP bruges bag proxyen.
# Tom = forespørgsler via NPM får ALDRIG admin (kun direkte på LAN :8137).
TRUSTED_PROXIES=
# Valgfri nøgle til admin udefra: https://f1live.slq.dk/admin?key=<nøgle>
ADMIN_TOKEN=
# Begræns selve visningen (tom = åben for alle der kender adressen).
# Fx kun LAN + WireGuard:  VIEW_ALLOW=30.11.0.0/20,10.0.0.0/20
VIEW_ALLOW=
# Eller en delbar nøgle:  https://f1live.slq.dk/?key=<nøgle>
VIEW_TOKEN=

# ---------- Web ----------
# Siden der må hente data på tværs af domæner (live.html på f1.slq.dk).
# Flere adskilles med komma.
ALLOW_ORIGIN=https://f1.slq.dk
TZ=Europe/Copenhagen

# ---------- Feed ----------
# auto   = forbind efter sæsonplan + F1's stream-status (anbefalet)
# always = altid forbundet
# off    = aldrig (kun afspilning af optagelser)
FEED_MODE=auto
# Minutter før/efter en planlagt session der forbindes
WINDOW_BEFORE_MIN=75
WINDOW_AFTER_MIN=90
# Hent F1's officielle arkiv efter hver session og teamradio-mp3'er (kræver F1 TV)
ARCHIVE_DOWNLOAD=true
TEAMRADIO_DOWNLOAD=true
LOG_RETENTION_DAYS=14
